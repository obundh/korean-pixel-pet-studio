{
  "name": "pixel-pet-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Turn any mascot into a transparent, animated desktop pixel pet.",
  "main": "dist-electron/main/index.js",
  "author": "obundh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/obundh/pixel-pet-studio.git"
  },
  "homepage": "https://github.com/obundh/pixel-pet-studio#readme",
  "bugs": {
    "url": "https://github.com/obundh/pixel-pet-studio/issues"
  },
  "keywords": [
    "pixel-art",
    "desktop-pet",
    "mascot",
    "electron",
    "background-removal"
  ],
  "scripts": {
    "prompts:generate": "node scripts/generate-prompt-catalog.mjs",
    "prompts:check": "node scripts/generate-prompt-catalog.mjs --check",
    "prepare:assets": "node scripts/sync-reference-kits.mjs && node scripts/prepare-background-removal.mjs",
    "dev": "npm run prepare:assets && concurrently -k -n renderer,electron-ts,electron -c cyan,magenta,yellow \"vite --host 127.0.0.1\" \"tsc -p tsconfig.electron.json --watch --preserveWatchOutput\" \"wait-on tcp:5173 file:dist-electron/main/index.js && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run prepare:assets && npm run typecheck && vite build && tsc -p tsconfig.electron.json",
    "dist": "npm run build && electron-builder --publish never",
    "dist:mac": "npm run build && electron-builder --mac dmg zip --x64 --arm64 --publish never",
    "dist:win": "npm run build && electron-builder --win nsis portable --publish never"
  },
  "dependencies": {
    "@imgly/background-removal": "1.7.0",
    "lucide-react": "^0.525.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.15",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^9.2.0",
    "cross-env": "^10.0.0",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "jsdom": "^26.1.0",
    "sharp": "^0.34.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "studio.pixelpet.app",
    "productName": "PixelPet Studio",
    "copyright": "Copyright © 2026 obundh",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "PixelPet-Studio-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "PixelPet-Studio-${version}-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "PixelPet-Studio-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "PixelPet-Studio-Portable-${version}-${arch}.${ext}"
    }
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "fsevents@2.3.3": true,
    "protobufjs@7.6.5": true,
    "sharp@0.34.5": true
  }
}
